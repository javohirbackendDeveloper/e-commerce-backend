// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Comments{
   id String @id @default(auto()) @map("_id") @db.ObjectId
   title String
   sent_person String
   image String?
   stars Int @default(0)
   replyMessage String?
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
   productId String @db.ObjectId
   product Product @relation(fields: [productId] , references: [id])
   @@index([sent_person])
}

enum ProductStatus {
  FAOL
  NOFAOL
  TUGAGAN
}

model Product {
 id String @id @default(auto()) @map("_id") @db.ObjectId

 product_name String 
 description String @default("")
 oldPrice Float
 price Float 

 quantity Int
 color String[]
 product_images ProductImage[]
 filters Json

 ordered String[] @default([])
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 comments Comments[]
 likes LikedProduct[]
categoryId String @db.ObjectId 
 category Category @relation(fields: [categoryId] , references: [id])
 
 brandId String @db.ObjectId
 brand  Brand @relation(fields: [brandId] , references: [id])
 

 product_status ProductStatus @default(FAOL)
 @@index([categoryId])
 @@index([product_name])
}


model ProductImage {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl String
  productId String @db.ObjectId
  product Product @relation(fields: [productId] , references: [id])
}



// CATEGORY PART

model Category {
     id String @id @default(auto()) @map("_id") @db.ObjectId
     parentId String?
     icon String?
     title String @unique
     children Int @default(0)
     product Product[]
     brand BrandCategory[]
     filter FilterCategory[]
}



// LIKED PRODUCTS


model LikedProduct {
     id String @id @default(auto()) @map("_id") @db.ObjectId
     userId String?
     productId String @db.ObjectId
     product Product @relation(fields: [productId] , references: [id])
     createdAt DateTime @default(now())

}


// brand model 



model Brand {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  categories BrandCategory[]
  product Product[]
}


model BrandCategory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  brandId String @db.ObjectId
  categoryId String @db.ObjectId

  brand Brand @relation(fields: [brandId] , references: [id])
  category Category @relation(fields: [categoryId] , references: [id])

  @@unique([brandId , categoryId])
}









// filters model

enum InputType {
  CHECKBOX
  SELECT
  RANGE
}

enum TypeOfFilter {
  GENERAL
  SPECIFIC
}

model FilterType {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String @unique
  inputType InputType
  type TypeOfFilter @default(GENERAL)
  filterCategory FilterCategory[] 
  values FilterValues[]
}

model FilterValues {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  value     String
  filterId  String      @db.ObjectId
  filter    FilterType  @relation(fields: [filterId], references: [id])

  @@unique([value , filterId])
}

model FilterCategory{
  id String @id @default(auto()) @map("_id") @db.ObjectId
 

  categoryId String @db.ObjectId
  filterId String @db.ObjectId

  category Category @relation(fields: [categoryId] , references: [id])
  filter FilterType @relation(fields: [filterId] , references: [id])
  
  @@unique([categoryId , filterId])
}


