generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Roles {
  User
  Admin
  SuperAdmin
  Courier
  PunktAdmin
}

model PunktAdmin {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  username     String  @unique
  punktId      String?
  password     String
  first_name   String?
  last_name    String?
  phone_number String
  role         Roles   @default(PunktAdmin)
}
