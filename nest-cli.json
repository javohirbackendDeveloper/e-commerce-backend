{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "root": "apps/e_commerce",
  "projects": {
    "api_gateway": {
      "type": "application",
      "root": "apps/api_gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api_gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api_gateway/tsconfig.app.json"
      }
    },
    "auth_service": {
      "type": "application",
      "root": "apps/auth_service",
      "entryFile": "main",
      "sourceRoot": "apps/auth_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth_service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "order_service": {
      "type": "application",
      "root": "apps/order_service",
      "entryFile": "main",
      "sourceRoot": "apps/order_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order_service/tsconfig.app.json"
      }
    },
    "products_service": {
      "type": "application",
      "root": "apps/products_service",
      "entryFile": "main",
      "sourceRoot": "apps/products_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/products_service/tsconfig.app.json"
      }
    },
    "punkt_service": {
      "type": "application",
      "root": "apps/punkt_service",
      "entryFile": "main",
      "sourceRoot": "apps/punkt_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/punkt_service/tsconfig.app.json"
      }
    },
    "staff_service": {
      "type": "application",
      "root": "apps/staff_service",
      "entryFile": "main",
      "sourceRoot": "apps/staff_service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/staff_service/tsconfig.app.json"
      }
    }
  }
}