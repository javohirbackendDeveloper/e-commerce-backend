generator client {
  provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-openssl-3.0.x"]

}


datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Days {
  DUSHANBA
  SESHANBA
  CHORSHANBA
  PAYSHANBA
  JUMA
  SHANBA
  YAKSHANBA
}
model WorkingHours {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  day Days
  start_time String
  end_time String

  punktId String @db.ObjectId
  punkt Punkt @relation(fields: [punktId] , references: [id])
}

model Punkt {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // general info
    workingHours WorkingHours[]
    canTryOn Boolean    @default(false)
    name String
    isActive Boolean @default(true)

    // location
    locationText String
    locationLongitude Float
    locationLatitude Float
    region String     
    city   String

    
    // staff
    punktAdminId String
    couriers String[] 
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

}




// locations model for punkts

model Province {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String @unique
  cities City[]
}


model City {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String
  parenProvinceId String @db.ObjectId
  parentProvince Province @relation(fields: [parenProvinceId] , references: [id])
}