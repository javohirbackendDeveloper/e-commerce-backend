generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


enum AppliedPunktEnum {
  APPLIED
  REPAIRING
}
model ApplyForPunkt {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  phone_number String
  longitude Float
  latitude Float
  province String
  city String
  telegram_username String
  status AppliedPunktEnum @default(APPLIED)
}


